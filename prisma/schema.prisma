generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        Int      @id @default(autoincrement())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  phone String @unique
  hash  String

  first_name String
  last_name  String?
  email      String?
  address    String?

  sentParcels Parcel[]  @relation(name: "Sender")
  Payment     Payment[] @relation(name: "User")
}

model ParcelStatus {
  id Int @id @default(autoincrement())

  status String @unique

  Parcel Parcel[]
}

model Parcel {
  id        Int      @id @default(autoincrement())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sender_id        Int
  sender           User   @relation(name: "Sender", fields: [sender_id], references: [id])
  sender_address   String
  reciever_phone   String
  reciever_address String

  width     Float
  height    Float
  length    Float
  weight    Float
  status_id Int          @default(1)
  status    ParcelStatus @relation(fields: [status_id], references: [id])
}

model Payment {
  id        Int      @id @default(autoincrement())
  createdAt DateTime @default(now())

  amount      Int
  card_number String
  expiration  String
  cvv         String
  postal_code String

  user_id Int
  user    User @relation(name: "User", fields: [user_id], references: [id])
}
